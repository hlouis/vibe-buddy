# PlatformIO
firmware/.pio/
firmware/.vscode/
firmware/.cache/

# Xcode — xcodeproj is generated from project.yml via xcodegen
macos-app/build/
macos-app/DerivedData/
macos-app/*.xcodeproj/
ios-app/build/
ios-app/DerivedData/
ios-app/*.xcodeproj/

# Per-dev signing settings (Team ID, signing style). Tracked template
# is Local.xcconfig.example; each contributor copies it to Local.xcconfig
# and fills in their own DEVELOPMENT_TEAM. See README.
macos-app/Local.xcconfig
ios-app/Local.xcconfig
shared/.build/
shared/build/
**/*.xcuserdata/
**/xcuserdata/
**/*.xcworkspace/xcuserdata/

# macOS
.DS_Store

# Secrets / local config
config.json
.env

# Python venv for tools/
tools/.venv/
__pycache__/

